# LoveLaundry monolith — union of all Python microservice envs.
# Single process serves every route; each subsystem keeps its own DB name
# so existing data does not need migration.

# ─── Shared auth/encryption (MUST be identical across subsystems) ──
JWT_SECRET=change-me-in-production
MASTER_KEY=change-me-in-production

# ─── Bill subsystem ───────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017
MONGO_DB_NAME=bill_db

# ─── Laundry-management subsystem (three-DB overrides, optional) ──
MONGODB_MAIN_URI=mongodb://localhost:27017
MONGODB_MAIN_DB=laundry_management

# ─── Users subsystem ──────────────────────────────────────────────
MONGODB_DB_NAME=users_db
MONGODB_COLLECTION=users

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://public.lovelaundry.lk,http://localhost:5173,http://localhost:3000
TZ=Asia/Colombo
