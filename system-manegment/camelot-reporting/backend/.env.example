# ---------------------------------------------------------------------------
# Camelot Beach Hotel — backend environment
# Copy to .env and change every secret before deploying.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100

# MongoDB connection string. Include the database name in the path.
MONGODB_URI=mongodb://127.0.0.1:27017/camelot_reporting

# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://lovelaundry-manager.vercel.app,https://system-lovelaundry-lk.vercel.app,https://lovelaundry-shop-app.vercel.app,https://hotels-manager-amber.vercel.app,https://hotels-manager.vercel.app,https://shops-manager.vercel.app,http://localhost,http://localhost:3000,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8101,http://127.0.0.1:8101,http://localhost:8820,http://127.0.0.1:8820

# Bootstrap administrator created by `npm run seed` when no users exist.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@camelotbeach.lk
ADMIN_PASSWORD=ChangeMe!2026

# Optional bootstrap operator.
OPERATOR_NAME=Front Office
OPERATOR_EMAIL=operator@camelotbeach.lk
OPERATOR_PASSWORD=Operator!2026

# Reporting
APP_TIMEZONE=Asia/Colombo
APP_CURRENCY=LKR

# Uploads / backups
MAX_UPLOAD_MB=50
BACKUP_DIR=./storage/backups
IMPORT_DIR=./storage/imports

# Set to true to trust a reverse proxy (nginx / Caddy) for client IPs.
TRUST_PROXY=false
