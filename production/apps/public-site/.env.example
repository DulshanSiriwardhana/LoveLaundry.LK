# Base URL of the chat backend that stores conversations (the quotation-service).
# Required: the widget throws a visible error on send when this is unset.
# The public bot service does not expose /chat/conversations, and vercel.json
# only rewrites /api/*, so there is no same-origin fallback.
VITE_CHAT_API_URL=https://your-quotation-service.vercel.app
