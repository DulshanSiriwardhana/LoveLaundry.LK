# Leave as /api when the backend is proxied same-origin. On Vercel set the
# deployed backend URL, e.g. https://your-backend.vercel.app
VITE_API_BASE_URL=/api
# Hotels for the tag generator come from user-service's /hotels list.
# On Vercel set this to the deployed user-service origin (no trailing /hotels).
# Locally, keep /api/user and set USER_SERVICE_URL for the dev proxy.
VITE_USER_API_URL=/api/user
# USER_SERVICE_URL=https://your-user-service.vercel.app
