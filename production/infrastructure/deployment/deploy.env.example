# Copy to .env and replace every CHANGE_ME value. Never commit the populated file.
APP_ENV=production
AUTH_REQUIRED=true

JWT_SECRET=CHANGE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
MASTER_KEY=CHANGE_ME_WITH_32_PLUS_RANDOM_CHARACTERS

MONGO_INITDB_ROOT_USERNAME=lovelaundry
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MONGODB_CENTRAL_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/central_system?authSource=admin
MONGODB_LAUNDRY_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/laundry_internal?authSource=admin
MONGODB_LINEN_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/linen_tracking?authSource=admin

ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://hotels-manager.vercel.app,https://shops-manager.vercel.app
EVENT_WORKER_ENABLED=true
EVENT_WORKER_INTERVAL_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=300
BACKUP_RETENTION_DAYS=7

# Hybrid QR + UHF RFID identity. Domains, EPC prefixes and radio settings are
# deployment configuration, never source-code constants.
QR_BASE_URL=https://api.YOUR_DOMAIN.example
QR_RATE_LIMIT_PER_MINUTE=60
RFID_EPC_PREFIX_HEX=CHANGE_ME_WITH_ASSIGNED_HEX_PREFIX
RFID_EPC_LENGTH=24
RFID_REGION=LK
# Leave empty when the regulator/reader profile does not fix one frequency.
RFID_FREQUENCY_MHZ=
RFID_MODE=production
RFID_ALLOW_SIMULATED_READS=false
TAG_INSPECTION_THRESHOLD_CYCLES=250
TAG_REPLACEMENT_PLANNING_THRESHOLD_CYCLES=275
TAG_RATED_LIMIT_ALERT_CYCLES=300

# Only needed with `docker compose --profile restore up mongo-restore`.
MONGO_RESTORE_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/?authSource=admin
RESTORE_SOURCE=/backup/CHANGE_ME_WITH_BACKUP_DIRECTORY
