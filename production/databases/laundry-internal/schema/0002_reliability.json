{
  "database": "laundry_internal",
  "version": 2,
  "collections": [
    {
      "name": "rate_cards",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["rate_card_id", "organization_id", "service", "unit_rate", "effective_from"],
          "properties": {
            "rate_card_id": {"bsonType": "string"},
            "organization_id": {"bsonType": "string"},
            "service": {"bsonType": "string"},
            "linen_category": {"bsonType": "string"},
            "unit": {"bsonType": "string"},
            "unit_rate": {"bsonType": "double"},
            "tax_rate": {"bsonType": "double"},
            "fixed_charge": {"bsonType": "double"},
            "effective_from": {"bsonType": "string"},
            "effective_to": {"bsonType": "string"},
            "created_at": {"bsonType": "string"}
          }
        }
      },
      "indexes": [
        {"keys": {"rate_card_id": 1}, "name": "rate_card_id", "unique": true},
        {"keys": {"organization_id": 1, "service": 1, "effective_from": 1}, "name": "effective_rate"}
      ]
    },
    {
      "name": "billing_runs",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["run_id", "organization_id", "hotel_id", "period_start", "period_end", "status", "idempotency_key"],
          "properties": {
            "run_id": {"bsonType": "string"},
            "organization_id": {"bsonType": "string"},
            "hotel_id": {"bsonType": "string"},
            "period_start": {"bsonType": "string"},
            "period_end": {"bsonType": "string"},
            "status": {"bsonType": "string"},
            "idempotency_key": {"bsonType": "string"},
            "transaction_ids": {"bsonType": "array", "items": {"bsonType": "string"}},
            "invoice_id": {"bsonType": "string"},
            "summary": {"bsonType": "object"},
            "created_by": {"bsonType": "string"},
            "created_at": {"bsonType": "string"}
          }
        }
      },
      "indexes": [
        {"keys": {"run_id": 1}, "name": "run_id", "unique": true},
        {"keys": {"idempotency_key": 1}, "name": "idempotency_key", "unique": true},
        {"keys": {"hotel_id": 1, "period_start": 1, "period_end": 1}, "name": "hotel_period"}
      ]
    },
    {
      "name": "billing_transactions",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["transaction_id", "organization_id", "hotel_id", "service", "quantity", "occurred_at"],
          "properties": {
            "transaction_id": {"bsonType": "string"},
            "organization_id": {"bsonType": "string"},
            "hotel_id": {"bsonType": "string"},
            "service": {"bsonType": "string"},
            "linen_category": {"bsonType": "string"},
            "quantity": {"bsonType": "double"},
            "occurred_at": {"bsonType": "string"},
            "source": {"bsonType": "string"},
            "billed_invoice_id": {"bsonType": "string"}
          }
        }
      },
      "indexes": [
        {"keys": {"transaction_id": 1}, "name": "transaction_id", "unique": true},
        {"keys": {"hotel_id": 1, "occurred_at": 1}, "name": "hotel_date"},
        {"keys": {"billed_invoice_id": 1}, "name": "billed_invoice"}
      ]
    },
    {
      "name": "invoice_lines",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["line_id", "invoice_id", "description", "quantity", "unit_rate", "amount"],
          "properties": {
            "line_id": {"bsonType": "string"},
            "invoice_id": {"bsonType": "string"},
            "description": {"bsonType": "string"},
            "quantity": {"bsonType": "double"},
            "unit_rate": {"bsonType": "double"},
            "amount": {"bsonType": "double"},
            "transaction_ids": {"bsonType": "array", "items": {"bsonType": "string"}}
          }
        }
      },
      "indexes": [
        {"keys": {"line_id": 1}, "name": "line_id", "unique": true},
        {"keys": {"invoice_id": 1}, "name": "invoice"}
      ]
    }
  ]
}
