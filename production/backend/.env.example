# Local/demo environment for production/backend.
# Copy to .env for local use. On Vercel, set these as project Environment Variables.

APP_ENV=development
AUTH_REQUIRED=true
PERSISTENCE=mongo

# In production both must be >= 32 characters.
JWT_SECRET=replace-with-a-32-plus-character-jwt-secret
MASTER_KEY=replace-with-a-32-plus-character-master-key
JWT_EXPIRES_HOURS=24
JWT_ALGORITHM=HS256

# Keep false on Vercel; background loops are not serverless-safe.
EVENT_WORKER_ENABLED=false
EVENT_WORKER_INTERVAL_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=300

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,https://lovelaundry-manager.vercel.app

MONGODB_CENTRAL_URI=mongodb://127.0.0.1:27017
MONGODB_CENTRAL_DB=central_system
MONGODB_LAUNDRY_URI=mongodb://127.0.0.1:27017
MONGODB_LAUNDRY_DB=laundry_internal
MONGODB_LINEN_URI=mongodb://127.0.0.1:27017
MONGODB_LINEN_DB=linen_tracking

# DATABASE_MIGRATIONS_DIR=

# Base origin only; the API appends /i/{linen_id} when printing QR labels.
QR_BASE_URL=http://localhost:8000
QR_RATE_LIMIT_PER_MINUTE=60

# Example prefix for local development only; production must use the assigned prefix.
RFID_EPC_PREFIX_HEX=3039
RFID_EPC_LENGTH=24
RFID_REGION=LK
RFID_FREQUENCY_MHZ=
RFID_MODE=development
# Simulated reads are permitted only with RFID_MODE=development|test.
RFID_ALLOW_SIMULATED_READS=true
TAG_INSPECTION_THRESHOLD_CYCLES=250
TAG_REPLACEMENT_PLANNING_THRESHOLD_CYCLES=275
TAG_RATED_LIMIT_ALERT_CYCLES=300
