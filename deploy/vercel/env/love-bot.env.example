# Vercel project: ll-love-bot
# Root Directory: system-manegment/love-bot
# Serverless function: api/chat.ts (no build command)

# PORT is only used by `npm start` locally; Vercel ignores it.
PORT=3001

# Optional shared secret. If set, quotation-service must set the same CHAT_API_KEY.
CHAT_API_KEY=

# Hosted OpenAI-compatible endpoint. localhost:11434 will NOT work on Vercel.
# Leave all four empty to use the built-in rule-based replies only.
LLM_PROVIDER=openai
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Live data lookups used by the bot.
QUOTATION_SERVICE_URL=https://ll-quotation-service.vercel.app
BILL_SERVICE_URL=https://ll-bill-service.vercel.app
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY
