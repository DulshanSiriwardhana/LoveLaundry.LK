# Vercel projects: ll-platform-admin, ll-hotel-scanner, ll-laundry-scanner,
# ll-laundry-internal, ll-linen-tracking
# Root Directories: production/apps/<app-name>

# The apps default to same-origin /api. On Vercel they are separate projects,
# so point them at the deployed production backend.
VITE_API_BASE_URL=https://ll-production-backend.vercel.app
