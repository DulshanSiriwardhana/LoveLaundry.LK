# REFERENCE ONLY — not a Vercel project.
# Values in this file are reused by several backends. Vercel does not share
# environment variables between projects: add the relevant lines to each one.

# Generate TWO independent values once and reuse them verbatim:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_THE_SAME_48_CHAR_JWT_SECRET_IN_EVERY_BACKEND
MASTER_KEY=REPLACE_WITH_THE_SAME_48_CHAR_MASTER_KEY_IN_EVERY_BACKEND

# Hosted MongoDB. Never use localhost on Vercel.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=lovelaundry

# Three-database role model (optional but recommended).
MONGODB_SECONDARY_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_SECONDARY_DB=lovelaundry_secondary
MONGODB_LOCAL_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_LOCAL_DB=lovelaundry_local

# Must contain every deployed frontend origin, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://public.lovelaundry.lk,https://shop.lovelaundry.lk,https://hotel.lovelaundry.lk,https://linen.lovelaundry.lk,https://your-quotations-ui.vercel.app
# Some services read CORS_ORIGINS instead; JSON array form is accepted there.
CORS_ORIGINS=["https://lovelaundry-manager.vercel.app","https://public.lovelaundry.lk","https://shop.lovelaundry.lk","https://hotel.lovelaundry.lk","https://linen.lovelaundry.lk"]

TZ=Asia/Colombo
