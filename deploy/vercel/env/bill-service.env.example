# Vercel project: ll-bill-service
# Root Directory: system-manegment/bill-service

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
# MONGO_URI is an alias of DATABASE_URL in this service; set either one.
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGO_DB_NAME=bills
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=bills

# Optional verification/replica databases.
MONGODB_SECONDARY_URI=
MONGODB_SECONDARY_DB=
MONGODB_LOCAL_URI=
MONGODB_LOCAL_DB=

# Authorization looks users up in this database.
USER_SERVICE_DB_NAME=users_db

# ── Shared secrets (must match user-service, quotation-service, worker-service,
#    laundry-management, love-ai) ──────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_THE_SHARED_JWT_SECRET
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY

# ── CORS / observability ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://public.lovelaundry.lk,https://your-quotations-ui.vercel.app
CORS_ORIGINS=["https://lovelaundry-manager.vercel.app","https://public.lovelaundry.lk"]
SENTRY_DSN=

# ── Sync (disabled on Vercel; code skips workers when VERCEL=1) ──────────────
SYNC_ENABLED=false
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

TZ=Asia/Colombo
