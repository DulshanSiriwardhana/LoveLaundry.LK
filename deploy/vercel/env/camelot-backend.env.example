# REFERENCE — camelot-reporting/backend is not deployable to Vercel as-is.
# It has no api/ handler and no src/index.ts / dist/index.js entry point.
# Add a serverless Express handler before using these values.

NODE_ENV=production
PORT=4100
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/camelot_reporting

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

CORS_ORIGIN=https://your-camelot-frontend.vercel.app

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@camelotbeach.lk
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
OPERATOR_NAME=Front Office
OPERATOR_EMAIL=operator@camelotbeach.lk
OPERATOR_PASSWORD=REPLACE_WITH_A_STRONG_OPERATOR_PASSWORD

APP_TIMEZONE=Asia/Colombo
APP_CURRENCY=LKR
MAX_UPLOAD_MB=50
BACKUP_DIR=./storage/backups
IMPORT_DIR=./storage/imports
TRUST_PROXY=true
