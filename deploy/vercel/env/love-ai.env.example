# Vercel project: ll-love-ai
# Root Directory: system-manegment/love-ai

MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGO_DB_NAME=laundry_management
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=laundry_management

# REQUIRED. Must be a real secret and identical to the other backends.
# The placeholder CHANGE-ME-IN-PRODUCTION-love-laundry-2026 is rejected at startup.
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY
# REQUIRED for tenant isolation: same JWT_SECRET as user-service.
JWT_SECRET=REPLACE_WITH_THE_SHARED_JWT_SECRET

# Comma-separated plaintext API keys (stored hashed). Also injected into the UI as VITE_AI_API_KEY.
LOVE_AI_API_KEYS=REPLACE_WITH_A_LONG_RANDOM_AI_KEY
SIGNATURE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

CORS_ORIGINS=https://lovelaundry-manager.vercel.app,https://your-quotations-ui.vercel.app
TZ=Asia/Colombo
