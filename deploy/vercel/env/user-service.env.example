# Vercel project: ll-user-service
# Root Directory: system-manegment/user-service

DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
# Code default is user_db; historical deployments use users_db. Set explicitly.
MONGODB_DB_NAME=users_db
MONGODB_MAIN_DB=users_db
MONGODB_COLLECTION=users

MONGODB_SECONDARY_URI=
MONGODB_SECONDARY_DB=
MONGODB_LOCAL_URI=
MONGODB_LOCAL_DB=

JWT_SECRET=REPLACE_WITH_THE_SHARED_JWT_SECRET
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY

# Access token lifetime in hours (default 0.25 = 15 minutes).
ACCESS_TOKEN_TTL_HOURS=0.25
# Tenant slug used for historical records / membership backfill.
DEFAULT_TENANT=lovelaundry

ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://public.lovelaundry.lk,https://your-quotations-ui.vercel.app
CORS_ORIGINS=["https://lovelaundry-manager.vercel.app","https://public.lovelaundry.lk"]
SENTRY_DSN=

SYNC_ENABLED=false
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

TZ=Asia/Colombo
