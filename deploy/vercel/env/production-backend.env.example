# Vercel project: ll-production-backend
# Root Directory: production/backend
# Python 3.12. api/index.py was added to this repo for Vercel.

APP_ENV=production
AUTH_REQUIRED=true
PERSISTENCE=mongo

# Both secrets must be at least 32 characters when APP_ENV=production.
JWT_SECRET=REPLACE_WITH_A_32_PLUS_CHAR_JWT_SECRET
MASTER_KEY=REPLACE_WITH_A_32_PLUS_CHAR_MASTER_KEY
JWT_EXPIRES_HOURS=24
JWT_ALGORITHM=HS256

# Keep these false on Vercel: background loops are not serverless-safe.
EVENT_WORKER_ENABLED=false
EVENT_WORKER_INTERVAL_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=300

ALLOWED_ORIGINS=https://your-platform-admin.vercel.app,https://your-hotel-scanner.vercel.app,https://your-laundry-scanner.vercel.app,https://your-laundry-internal.vercel.app,https://your-linen-tracking.vercel.app

MONGODB_CENTRAL_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_CENTRAL_DB=central_system
MONGODB_LAUNDRY_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_LAUNDRY_DB=laundry_internal
MONGODB_LINEN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_LINEN_DB=linen_tracking

# Leave unset on Vercel unless migrations are packaged with the function.
# DATABASE_MIGRATIONS_DIR=

QR_BASE_URL=https://your-public-site.vercel.app/track
QR_RATE_LIMIT_PER_MINUTE=60

RFID_EPC_PREFIX_HEX=
RFID_EPC_LENGTH=24
RFID_REGION=LK
RFID_FREQUENCY_MHZ=
RFID_MODE=production
RFID_ALLOW_SIMULATED_READS=false
TAG_INSPECTION_THRESHOLD_CYCLES=250
TAG_REPLACEMENT_PLANNING_THRESHOLD_CYCLES=275
TAG_RATED_LIMIT_ALERT_CYCLES=300
