# Vercel project: ll-recreated-backend
# Root Directory: architecture_updated_system/backend
# Python 3.12. api/index.py was added to this repo for Vercel.

JWT_SECRET=REPLACE_WITH_THE_SHARED_JWT_SECRET
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY

APP_ENV=production
TZ=Asia/Colombo
ALLOWED_ORIGINS=https://ll-recreated-app.vercel.app,https://ll-system-info-ui.vercel.app
CORS_ORIGINS=https://ll-recreated-app.vercel.app

# MAIN / SECONDARY / LOCAL database roles.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGO_DB_NAME=lovelaundry
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=lovelaundry
MONGODB_SECONDARY_URI=
MONGODB_SECONDARY_DB=
MONGODB_LOCAL_URI=
MONGODB_LOCAL_DB=

# Sync loops are skipped on Vercel; run them in an external worker instead.
SYNC_ENABLED=false
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

LOVE_AI_API_KEYS=REPLACE_WITH_A_LONG_RANDOM_AI_KEY
JWT_EXPIRES_HOURS=24
JWT_ALGORITHM=HS256
SIGNATURE_TTL_SECONDS=300

PUBLIC_BASE=https://public.lovelaundry.lk
CHAT_BOT_URL=https://ll-love-bot.vercel.app
CHAT_API_KEY=
