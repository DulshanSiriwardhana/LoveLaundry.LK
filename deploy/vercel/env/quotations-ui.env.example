# Vercel project: ll-quotations-ui
# Root Directory: system-manegment/quotations-ui
# VITE_* values are baked into the bundle at build time — redeploy after changes.

VITE_API_URL=https://ll-quotation-service.vercel.app
VITE_BILLS_API_URL=https://ll-bill-service.vercel.app
VITE_USER_API_URL=https://ll-user-service.vercel.app
VITE_WORKERS_API_URL=https://ll-worker-service.vercel.app
VITE_MGMT_API_URL=https://ll-laundry-management.vercel.app
VITE_AI_API_URL=https://ll-love-ai.vercel.app
VITE_AI_API_KEY=REPLACE_WITH_THE_AI_API_KEY_FROM_LOVE_AI

# Public origin that serves QR tracking links.
VITE_TRACK_BASE_URL=https://public.lovelaundry.lk

VITE_APP_TITLE="LoveLaundry Management System"

