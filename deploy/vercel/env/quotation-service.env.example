# Vercel project: ll-quotation-service
# Root Directory: system-manegment/quotation-service

DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=LoveLaundry
MONGODB_DB_NAME=quotations_db
MONGODB_MAIN_DB=quotations_db
MONGODB_COLLECTION=quotations

MONGODB_SECONDARY_URI=
MONGODB_SECONDARY_DB=
MONGODB_LOCAL_URI=
MONGODB_LOCAL_DB=

JWT_SECRET=REPLACE_WITH_THE_SHARED_JWT_SECRET
MASTER_KEY=REPLACE_WITH_THE_SHARED_MASTER_KEY

# Base URL of the deployed love-bot. This service calls <CHAT_BOT_URL>/api/chat.
CHAT_BOT_URL=https://ll-love-bot.vercel.app
# Set the same value on love-bot if you enable this.
CHAT_API_KEY=

# Tenant whose shop quotations are published on the public storefront.
PUBLIC_LAUNDRY_ID=lovelaundry
# Origin used to build QR tracking URLs.
PUBLIC_BASE=https://public.lovelaundry.lk

ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://public.lovelaundry.lk,https://your-quotations-ui.vercel.app
CORS_ORIGINS=["https://lovelaundry-manager.vercel.app","https://public.lovelaundry.lk"]
SENTRY_DSN=

SYNC_ENABLED=false
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

TZ=Asia/Colombo
