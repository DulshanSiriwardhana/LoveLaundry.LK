# LoveLaundry self-hosted backend env.
# Copy to `backend.env` (same directory) and fill real values.
# WARNING: The Docker entrypoints refuse to start while either value below is unchanged.
# Generate each secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# ============ Shared: JWT + encryption + sync ============
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-love-laundry-2026
MASTER_KEY=CHANGE-ME-IN-PRODUCTION-love-laundry-2026
SYNC_ENABLED=false
ALLOWED_ORIGINS=http://localhost

# All backends share this main database; service collections are configured in Compose.
MONGODB_MAIN_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=laundry_management

# ============ quotation-service (quotation-backend) ============
CHAT_BOT_URL=https://your-love-bot.vercel.app

# ============ worker-service (workers-backend) ============
MONGODB_WORKERS_COLLECTION=workers
MONGODB_DAILY_LOGS_COLLECTION=daily_task_logs

# ============ love-ai (ai-backend) ============
SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost"]
RATE_LIMIT_PER_MINUTE=120

# Optional internal-service credentials are passed only to the service that needs them:
# Set CHAT_API_KEY in the environment running `docker compose` to share it with quotation-backend.
# Set LOVE_AI_API_KEYS in that environment only if an internal client needs API-key authentication.
# Do not put either key in this shared env file or in frontend VITE_* variables.