# system_info scanner — example environment
# The scanner is READ-ONLY and path-bounded to SCAN_SOURCE_ROOT.

# Absolute path to the tree to scan. Defaults to the repository root's parent
# sibling `system-manegment` when run from the repo; set explicitly in Docker.
SCAN_SOURCE_ROOT=/abs/path/to/LoveLaundry.LK/system-manegment

# Bind to loopback by default: this tool must not be exposed publicly.
SCAN_BIND_HOST=127.0.0.1
SCAN_BIND_PORT=8810

# Optional shared token required on every /api request (empty = loopback-only trust)
SCAN_API_KEY=
