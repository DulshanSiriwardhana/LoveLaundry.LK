# ── LoveLaundry recreated backend — example environment ─────────────────────
# Copy to `.env` and fill values. NEVER commit real secrets.

# Required shared secrets (must match the legacy values to interoperate)
JWT_SECRET=change-me-jwt
MASTER_KEY=change-me-master

# Application
APP_ENV=development
TZ=Asia/Colombo
ALLOWED_ORIGINS=*

# ── Three-database role model ────────────────────────────────────────────────
# MAIN = production source of truth; SECONDARY = verification replica;
# LOCAL = admin-triggered replica (never an API read source).
MONGODB_MAIN_URI=mongodb://localhost:27017
MONGODB_MAIN_DB=lovelaundry
MONGODB_SECONDARY_URI=mongodb://localhost:27017
MONGODB_SECONDARY_DB=lovelaundry_secondary
MONGODB_LOCAL_URI=mongodb://localhost:27017
MONGODB_LOCAL_DB=lovelaundry_local

# Legacy fallbacks (optional)
# MONGO_URI=
# MONGO_DB_NAME=
# DATABASE_URL=

# Sync worker
SYNC_ENABLED=true
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

# ── system_info scanner (see system_info/backend) ────────────────────────────
# SCAN_SOURCE_ROOT=/absolute/path/to/legacy
# SCAN_BIND_HOST=127.0.0.1
# SCAN_BIND_PORT=8810
