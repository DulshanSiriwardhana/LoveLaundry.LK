# Recreated system — root-level example.
# The existing .env in this directory contains real-looking values: rotate them.

JWT_SECRET=change-me-jwt
MASTER_KEY=change-me-master

APP_ENV=development
TZ=Asia/Colombo
ALLOWED_ORIGINS=http://localhost:8101,http://localhost:8820,http://localhost:5173

DATABASE_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=quotations_db
MONGODB_COLLECTION=quotations

MONGODB_MAIN_URI=mongodb://127.0.0.1:27017
MONGODB_MAIN_DB=lovelaundry
MONGODB_SECONDARY_URI=mongodb://127.0.0.1:27017
MONGODB_SECONDARY_DB=lovelaundry_secondary
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
MONGODB_LOCAL_DB=lovelaundry_local

SYNC_ENABLED=true
SYNC_WORKER_POLL_SECONDS=1.0
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_SECONDS=3

CHAT_BOT_URL=
CHAT_API_KEY=
PUBLIC_BASE=https://public.lovelaundry.lk

# system_info scanner (local only)
# SCAN_SOURCE_ROOT=/abs/path/to/LoveLaundry.LK/system-manegment
# SCAN_BIND_HOST=127.0.0.1
# SCAN_BIND_PORT=8810
# SCAN_API_KEY=
